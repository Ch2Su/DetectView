<Window x:Class="DetectView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DetectView"
        Title="DetectView — 실시간 객체 검출"
        Height="820" Width="1200"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Deactivated="Window_Deactivated">

    <!-- 시안 B '관제 콘솔' (2026-11-01): 왼쪽 패널(소스·분석·추론 장치·정지) | 영상과 재생 줄, 맨 아래 창 전체 폭 상태바.
         색·글꼴·컨트롤 모양은 App.xaml 한 곳에 있다. UI 테스트가 x:Name·버튼 글자·상태 문구로 요소를 찾으므로 바꾸면 테스트도 고칠 것 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 왼쪽 패널 ===== -->
            <!-- 최소 폭(900)에서도 모든 조작이 한눈에 보인다 (예전 가로 툴바는 두 줄로 넘어갔다). 낮은 창에선 위쪽만 스크롤되고 정지는 늘 아래에 -->
            <Border Grid.Column="0" Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,0">
                <DockPanel Margin="14,16,14,14">
                    <Button x:Name="Btn_Stop"
                            DockPanel.Dock="Bottom" Margin="0,12,0,0"
                            Content="정지" local:Ui.Glyph="&#xE71A;"
                            Style="{StaticResource DangerButton}"
                            IsEnabled="False"
                            Click="Btn_Stop_Click"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="소스" Style="{StaticResource SectionLabel}"/>

                            <!-- 지금 소스 버튼(파일·카메라·HUD)은 강조 바탕으로 켜진다 (ApplyModeToUi 의 Ui.IsActive) -->
                            <Button x:Name="Btn_LoadVideo"
                                    Content="파일 열기" local:Ui.Glyph="&#xED25;"
                                    Style="{StaticResource SideButton}"
                                    Click="Btn_LoadVideo_Click"/>

                            <TextBlock Text="카메라" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CameraSelector"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="Btn_RefreshCameras"
                                        Content="새로고침" local:Ui.Glyph="&#xE72C;" local:Ui.IconOnly="True"
                                        Width="34" Margin="0,0,6,0"
                                        Style="{StaticResource SideButton}"
                                        ToolTip="카메라·모니터 목록 새로고침"
                                        Click="Btn_RefreshCameras_Click"/>
                                <Button x:Name="Btn_StartCamera" Grid.Column="1"
                                        Content="카메라 시작" local:Ui.Glyph="&#xE714;"
                                        Style="{StaticResource SideButton}"
                                        Click="Btn_StartCamera_Click"/>
                            </Grid>

                            <TextBlock Text="모니터" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="MonitorSelector"/>
                            <Button x:Name="Btn_Screen" Margin="0,6,0,0"
                                    Content="화면 HUD" local:Ui.Glyph="&#xE9A6;"
                                    Style="{StaticResource SideButton}"
                                    ToolTip="바탕화면을 실시간 캡처해, 화면 위에 투명 오버레이로 검출 박스를 표시합니다"
                                    Click="Btn_Screen_Click"/>

                            <TextBlock Text="분석" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                            <Button x:Name="Btn_Sahi"
                                    Content="정밀 분석(SAHI)" local:Ui.Glyph="&#xE8A3;"
                                    Style="{StaticResource SideButton}"
                                    IsEnabled="False"
                                    ToolTip="현재 프레임을 타일로 나눠 정밀 검출합니다 (작은 객체에 유리, 다소 느림)"
                                    Click="Btn_Sahi_Click"/>

                            <!-- 관심 구역(ROI): 파일 재생을 멈춘 채 영상 위에서 그린다 (RoiLayer.cs · MainWindow.Roi.cs). 구역은 영상 파일 옆
                                 <이름>.roi.json 에 바뀔 때마다 바로 저장된다. 편집할 수 없을 땐(재생 중·파일이 아님) 막고 사유를 툴팁에 (ShowOnDisabled) -->
                            <Grid Margin="0,22,0,8">
                                <TextBlock Text="구역" Style="{StaticResource SectionLabel}" Margin="0"/>
                                <!-- 개수. 툴팁에 구역 파일 경로 (예전엔 목록 아래 줄로 보였지만, 그 한 줄 때문에 기본 창 높이에서 '추론 장치' 콤보가 스크롤 아래로 밀렸다) -->
                                <TextBlock x:Name="Txt_ZoneCount" HorizontalAlignment="Right"
                                           FontSize="{StaticResource LabelFontSize}" Foreground="{StaticResource SubTextBrush}"
                                           ToolTipService.ShowDuration="60000"/>
                            </Grid>
                            <!-- 3줄까지 보이고 그 위로는 목록 안에서 스크롤 — 기본 창 높이(820)에서 패널 전체가 스크롤 없이 보이게 -->
                            <ListBox x:Name="ZoneList" Style="{StaticResource ZoneListBox}" MaxHeight="99"
                                     ToolTipService.ShowOnDisabled="True"
                                     SelectionChanged="ZoneList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Background="{Binding FillBrush}" BorderBrush="{Binding Brush}" BorderThickness="1"/>
                                            <TextBlock Text="{Binding Label}" Width="26" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{Binding Brush}"/>
                                            <TextBlock Text="{Binding KindName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="Btn_ZoneAdd"
                                        Content="추가" local:Ui.Glyph="&#xE710;"
                                        Height="30" Style="{StaticResource SideButton}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="Btn_ZoneAdd_Click"/>
                                <Button x:Name="Btn_ZoneDelete" Grid.Column="2"
                                        Content="지우기" local:Ui.Glyph="&#xE74D;" local:Ui.GlyphBrush="{StaticResource DangerBrush}"
                                        Height="30" Style="{StaticResource SideButton}"
                                        ToolTipService.ShowOnDisabled="True"
                                        Click="Btn_ZoneDelete_Click"/>
                            </Grid>
                            <TextBlock Text="선택한 구역 유형" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ZoneKindSelector"
                                      ToolTipService.ShowOnDisabled="True"
                                      SelectionChanged="ZoneKindSelector_SelectionChanged"/>

                            <!-- 추론 장치. TensorRT·NPU 를 쓸 수 없으면 항목을 막고 사유를 툴팁에 둔다 (막힌 항목도 툴팁이 뜨게 ShowOnDisabled).
                                 TensorRT(2026-11-08)는 같은 NVIDIA GPU 를 다른 런타임으로 쓰는 것이라 GPU 바로 아래에 둔다.
                                 준비 진행은 상태바 오른쪽 Txt_Device 에 — 상태바는 HUD 캡처의 무시 영역이라 매초 바뀌어도 새 화면으로 치지 않는다 -->
                            <TextBlock Text="추론 장치" Style="{StaticResource SectionLabel}" Margin="0,22,0,8"/>
                            <ComboBox x:Name="InferenceSelector"
                                      local:Ui.Glyph="&#xE950;"
                                      ToolTipService.ShowDuration="60000"
                                      SelectionChanged="InferenceSelector_SelectionChanged">
                                <ComboBoxItem x:Name="Item_Gpu" Content="GPU" IsSelected="True"/>
                                <ComboBoxItem x:Name="Item_Trt" Content="TensorRT" IsEnabled="False"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTipService.ShowDuration="60000"/>
                                <ComboBoxItem x:Name="Item_Npu" Content="NPU" IsEnabled="False"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTipService.ShowDuration="60000"/>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== 영상 + 재생 줄 ===== -->
            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Black" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid ClipToBounds="True">
                        <!-- 모서리 눈금은 영상 뒤에 — 영상이 채우면 가려지고 레터박스·빈 화면에서만 보인다 -->
                        <Border Style="{StaticResource CornerTick}" HorizontalAlignment="Left" VerticalAlignment="Top" BorderThickness="2,2,0,0"/>
                        <Border Style="{StaticResource CornerTick}" HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="0,2,2,0"/>
                        <Border Style="{StaticResource CornerTick}" HorizontalAlignment="Left" VerticalAlignment="Bottom" BorderThickness="2,0,0,2"/>
                        <Border Style="{StaticResource CornerTick}" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderThickness="0,0,2,2"/>

                        <Image x:Name="MainImage" Stretch="Uniform" />
                        <!-- 관심 구역(ROI): 박스 밑에 깐다 — 박스·라벨이 구역 위에 보이고, 편집 중(멈춘 파일)에만 마우스를 받는다 (BoxLayer 는 마우스를 통과시킨다) -->
                        <local:RoiLayer x:Name="ZoneLayer" />
                        <!-- 검출 박스는 영상에 굽지 않고 그 위에 벡터로 그린다 — HUD 오버레이와 같은 BoxLayer 라 모양이 같고,
                             창·영상 크기와 상관없이 선 굵기·라벨 글자 크기가 일정하다. 클래스별 개수 범례도 이 칸의 왼쪽 위 모서리에 같이 그린다
                             (레터박스가 있으면 그 검은 띠 위라 영상을 안 가린다). 범례 글자는 Txt_DetectionCount 의 UIA ItemStatus 로 나간다 -->
                        <local:BoxLayer x:Name="FrameBoxes" />
                        <!-- 화면 전환 감지 배지 (MainWindow.Scene.cs): 카메라가 돌아가는 동안 '화면 이동 중'·검은 끊김엔 '화면 끊김', 안정돼 번호를 새로 매긴 직후 몇 초 '화면 전환 · 번호 새로 매김'.
                             오른쪽 위 — 왼쪽 위는 검출 범례. 평소엔 숨김 (UIA 에서도 사라진다). 글자색은 코드가 키로 정한다 -->
                        <Border x:Name="SceneBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                Padding="9,4" CornerRadius="2" Background="{StaticResource BadgeBackBrush}"
                                IsHitTestVisible="False" Visibility="Collapsed">
                            <TextBlock x:Name="Txt_SceneBadge" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="&#xE9A6;" FontFamily="{StaticResource IconFont}" FontSize="40"
                                       Foreground="{StaticResource EdgeBrush}" HorizontalAlignment="Center" Margin="0,0,0,14"
                                       Visibility="{Binding Visibility, ElementName=PlaceholderText}"/>
                            <TextBlock x:Name="PlaceholderText"
                                       Text="파일을 열거나 카메라를 시작하세요"
                                       Foreground="{StaticResource SubTextBrush}"
                                       FontSize="15"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 재생 줄 ===== -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Btn_PlayPause"
                            Grid.Column="0"
                            Content="재생"
                            Width="100"
                            Style="{StaticResource PlayButton}"
                            IsEnabled="False"
                            Click="Btn_PlayPause_Click"/>

                    <!-- 드래그 중 표시는 썸의 드래그 시작·끝으로 (MainWindow.xaml.cs — 캡처를 잃어도 DragCompleted 가 온다) -->
                    <Slider x:Name="VideoSlider"
                            Grid.Column="1"
                            VerticalAlignment="Center" Margin="14,0"
                            IsEnabled="False"
                            IsMoveToPointEnabled="True"
                            Thumb.DragStarted="VideoSlider_DragStarted"
                            Thumb.DragCompleted="VideoSlider_DragCompleted"
                            ValueChanged="VideoSlider_ValueChanged"/>

                    <TextBlock x:Name="Txt_Time"
                               Grid.Column="2"
                               Text="00:00 / 00:00"
                               FontFamily="{StaticResource MonoFont}"
                               VerticalAlignment="Center"
                               MinWidth="110" TextAlignment="Right"/>
                </Grid>

                <!-- ===== 구역 이벤트 로그 (MainWindow.Events.cs) =====
                     구역에 들어오고 나간 물체가 최근 순으로 쌓인다. 접어 두면 헤더 한 줄(기본), 펼치면 목록이 영상 칸을 그만큼 줄인다.
                     영상(파일)이 열려 있을 때만 보인다. [CSV 저장] 은 영상 옆 <영상>.events.csv. 시안: 영상 아래 접이식 로그 + 화면 + CSV 저장 버튼 -->
                <Border x:Name="EventLogPanel" Grid.Row="2" Margin="0,8,0,0" Visibility="Collapsed"
                        Background="{StaticResource SideBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="Btn_EventToggle"
                                    Content="이벤트 0건" local:Ui.Glyph="&#xE70E;"
                                    Height="26" Style="{StaticResource SideButton}"
                                    ToolTipService.ShowDuration="60000"
                                    Click="Btn_EventToggle_Click"/>
                            <!-- 풀리지 않은 유고 후보가 있을 때만 (IncidentRules.cs) — 로그를 접어 둬도 보이게 -->
                            <TextBlock x:Name="Txt_EventIncident" Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" Visibility="Collapsed"/>
                            <!-- VLM 설명 (MainWindow.Vlm.cs — docs/vlm-annotation.md): 유고 후보 행에 로컬 VLM(Ollama)의 단서·한 줄 설명을 붙인다. 기본 꺼짐.
                                 켜짐은 강조 바탕(Ui.IsActive), 상태(꺼짐 · 확인 중 · 켜짐)는 UIA ItemStatus — 글자(Content)는 바꾸지 않는다 -->
                            <Button x:Name="Btn_EventVlm" Grid.Column="2" Margin="6,0,0,0"
                                    Content="VLM 설명" local:Ui.Glyph="&#xE8BD;"
                                    Height="26" Style="{StaticResource SideButton}"
                                    ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000"
                                    Click="Btn_EventVlm_Click"/>
                            <Button x:Name="Btn_EventSave" Grid.Column="3" Margin="6,0,0,0"
                                    Content="CSV 저장" local:Ui.Glyph="&#xE74E;"
                                    Height="26" Style="{StaticResource SideButton}"
                                    ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000"
                                    IsEnabled="False"
                                    Click="Btn_EventSave_Click"/>
                            <Button x:Name="Btn_EventClear" Grid.Column="4" Margin="6,0,0,0"
                                    Content="비우기" local:Ui.Glyph="&#xE74D;" local:Ui.GlyphBrush="{StaticResource DangerBrush}"
                                    Height="26" Style="{StaticResource SideButton}"
                                    ToolTip="이벤트 목록을 비웁니다 (저장한 CSV 는 그대로)"
                                    IsEnabled="False"
                                    Click="Btn_EventClear_Click"/>
                        </Grid>
                        <ListBox x:Name="EventList" Grid.Row="1" Height="112" Margin="4,0,4,4"
                                 Style="{StaticResource LogListBox}" Visibility="Collapsed">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="20">
                                            <TextBlock Text="{Binding Time}" Width="58" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                            <TextBlock Text="{Binding LabelText}" Width="124" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding LabelBrush}"/>
                                            <TextBlock Text="{Binding ZoneText}" Width="118" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{Binding ZoneBrush}"/>
                                            <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center" FontSize="12" Foreground="{Binding ActionBrush}"/>
                                        </StackPanel>
                                        <!-- VLM 줄 (MainWindow.Vlm.cs — 시안 '두 줄 행'): 유고 후보 행에 VLM 상태가 있을 때만. 'VLM' 표 + 단서 칩 + 설명 한 줄(넘치면 …, 전문은 행 툴팁).
                                             라벨 열 밑(58px)에서 시작한다 -->
                                        <DockPanel Height="20" Margin="58,0,0,0" Visibility="{Binding VlmVisibility}">
                                            <Border DockPanel.Dock="Left" Height="16" Margin="0,0,6,0" Padding="4,0" CornerRadius="2" VerticalAlignment="Center"
                                                    BorderThickness="1" BorderBrush="{StaticResource EdgeBrush}">
                                                <TextBlock Text="VLM" FontFamily="{StaticResource MonoFont}" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                            </Border>
                                            <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding VlmChips}" Focusable="False" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Height="16" Margin="0,0,4,0" Padding="5,0" CornerRadius="2" BorderThickness="1"
                                                                Background="{Binding Back}" BorderBrush="{Binding Edge}">
                                                            <TextBlock Text="{Binding Text}" FontSize="11" VerticalAlignment="Center" Foreground="{Binding Fore}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding VlmText}" Foreground="{Binding VlmTextBrush}" FontSize="12" Margin="2,0,0,0"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 상태바 (창 전체 폭) ===== -->
        <!-- HUD 캡처의 무시 영역(_hudIgnoreRegion)이다 — 자주 바뀌는 표시(FPS·검출 수·NPU 진행)는 이 안에만 둔다. 밖에서 바뀌면 DXGI 가
             새 화면을 줘 정지 화면에서도 추론이 돈다. 숫자 칸도 UI 글꼴인 이유: 고정폭 글꼴이면 최소 폭(900)에서 HUD 상태 문구 칸이 16px 좁아졌다 -->
        <Border x:Name="StatusBarPanel" Grid.Row="1" Height="28" Padding="12,0"
                Background="{StaticResource StatusBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"
                TextElement.FontSize="{StaticResource StatusFontSize}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 소스가 켜져 있으면 초록 (ApplyModeToUi) -->
                <TextBlock x:Name="StatusDot" Grid.Column="0" Text="●"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>

                <!-- 폭을 넘으면 "…" 로 줄인다 (그냥 잘리면 잘린 줄도 모름). 긴 안내는 툴팁(코드에서 설정)으로,
                     여러 줄이라 기본 5초로는 다 못 읽어 1분까지 띄운다 -->
                <TextBlock x:Name="Txt_Status"
                           Grid.Column="1"
                           Text="준비"
                           TextTrimming="CharacterEllipsis"
                           ToolTipService.ShowDuration="60000"
                           VerticalAlignment="Center"/>

                <!-- 오른쪽 칸들 (오른쪽 끝에 붙은 StackPanel — 한 칸이 넓어지면 그 왼쪽 칸이 모두 밀린다).
                     FPS·검출 수 칸은 폭을 고정한다(MinWidth): 예전엔 내용 폭이라 값이 바뀔 때마다(87.3 → 102.1 FPS, 검출 9 → 15) 해상도·NPU 진행 글자가 밀렸다.
                     숫자는 같은 폭으로(Typography.NumeralAlignment=Tabular) — 이 글꼴은 12px Display 에서 '1' 이 '8' 보다 1px 좁아 자릿수가 같아도 FPS 글자 폭이 흔들렸다
                     ('검출 N' 처럼 한글 뒤 숫자는 맑은 고딕으로 그려져 듣지 않는다 — 칸 폭 고정으로 충분).
                     고정 폭(App.xaml 의 Status…Width)은 상태바 글꼴로 잰 가장 넓은 평소 글자: FPS 칸은 파일·카메라에선 숫자 '999.9 FPS', HUD 에선 그 자리에 숫자와
                     번갈아 뜨는 '대기 (화면 변화 없음)' — HUD 에서 FPS ↔ 대기가 자주 바뀌어도 안 밀리게, 평소엔 FPS 앞이 비지 않게 ApplyModeToUi 가 모드에 따라 고른다
                     (숫자는 오른쪽 맞춤). 검출 칸은 '검출 999'. 더 넓은 글자('검출 N (SAHI)')가 올 때만 칸이 넓어진다.
                     최소 창 폭(900)에서 상태 문구 칸은 HUD(FPS 칸이 가장 넓음)일 때도 가장 긴 HUD 문구(568px)가 들어간다 (2026-11-02 잼 — CLAUDE.md '화면 HUD') -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- NPU 준비·되돌리기 진행(경고 색)과 실패(위험 색)만 잠깐 보인다 (평소엔 숨김 — 상태바 폭을 Txt_Status 에 남긴다) -->
                    <TextBlock x:Name="Txt_Device"
                               Foreground="{StaticResource WarnBrush}"
                               Margin="18,0,0,0" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               ToolTipService.ShowDuration="60000"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="Txt_Resolution" Margin="18,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock x:Name="Txt_InferenceFps" Margin="18,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                               MinWidth="{DynamicResource StatusFpsWidth}" TextAlignment="Right"/>
                    <TextBlock x:Name="Txt_DetectionCount" Margin="18,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                               MinWidth="{StaticResource StatusCountWidth}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
