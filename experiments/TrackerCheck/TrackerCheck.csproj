<Project Sdk="Microsoft.NET.Sdk">

  <!-- 추적기 검증: 본 앱과 같은 패키지·TFM·공급자로 검출하고, 추적기·Det 는 본 앱 소스를 그대로 가져다 쓴다 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\WindowsMlExecutionProvider.cs" />
    <Compile Include="..\..\Detection.cs" />
    <Compile Include="..\..\Tracker.cs" />
    <Compile Include="..\..\Sahi.cs" />
    <Compile Include="..\..\GpuAdapters.cs" />
    <Compile Include="..\..\Roi.cs" />
    <Compile Include="..\..\SceneThumbnail.cs" />
    <Compile Include="..\..\SceneChange.cs" />
    <Compile Include="..\..\ZoneEvents.cs" />
    <Compile Include="..\..\IncidentRules.cs" />
    <Compile Include="..\..\ViewIdentity.cs" />
    <Compile Include="..\..\YoloLetterbox.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <!-- OpenCvSharp 판은 저장소 루트 Directory.Build.props 의 OpenCvSharpVersion (본 앱과 같은 값) -->
    <PackageReference Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="YoloDotNet" Version="4.2.0" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" />
  </ItemGroup>

</Project>
