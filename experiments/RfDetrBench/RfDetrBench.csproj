<Project Sdk="Microsoft.NET.Sdk">

  <!-- RF-DETR 를 본 앱의 런타임(Windows ML 의 ONNX Runtime + DirectML)에서 돌려 보는 실험 — README.
       모델·기준 이미지·파이썬 기준값은 export_rfdetr.py 가 out/ 에 만든다. 본 앱과 따로 빌드한다 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- NpuBench 와 같게 — Windows ML 패키지가 Windows 10 SDK 버전이 붙은 TFM 을 요구한다 -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- MSIX 없이 실행 (Windows ML 런타임은 self-contained 로 exe 옆에 복사된다) -->
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 본 앱과 같은 판 (CLAUDE.md 1번) -->
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" Version="2.4.89" />
    <!-- 판은 저장소 루트 Directory.Build.props 의 OpenCvSharpVersion -->
    <PackageReference Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="$(OpenCvSharpVersion)" />
  </ItemGroup>

</Project>
