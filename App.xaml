<Application x:Class="YOLO11_Test.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:YOLO11_Test"
             mc:Ignorable="po"
             StartupUri="MainWindow.xaml">
    <!-- 화면 모양은 이 파일 한 곳에서 바꾼다 — 시안 B '관제 콘솔' · 색 조합 B2 '스틸 블루' (2026-11-01).
         코드는 색을 직접 쓰지 않고 아래 키를 찾는다: 제목 표시줄(BaseColor·WindowEdgeColor·TextColor), 상태 점·라이브 표시·FPS 칸 문제 문구·NPU 진행
         (…Brush), 검출 박스(Box.*). 키 이름을 바꾸면 코드도 같이 고칠 것 -->
    <Application.Resources>

        <!-- ===== 색 ===== -->
        <Color x:Key="BaseColor">#0E141C</Color>              <!-- 창 바탕 · 제목 표시줄 -->
        <Color x:Key="SideColor">#121A24</Color>              <!-- 왼쪽 패널 · 꺼진 버튼 -->
        <Color x:Key="RaisedColor">#18222E</Color>            <!-- 버튼 -->
        <Color x:Key="RaisedHoverColor">#1F2B3A</Color>
        <Color x:Key="FieldColor">#0B1118</Color>             <!-- 콤보 칸 · 누른 버튼 -->
        <Color x:Key="PopupColor">#151E29</Color>             <!-- 콤보 펼침 · 툴팁 -->
        <Color x:Key="StatusColor">#0A0F15</Color>            <!-- 상태바 -->
        <Color x:Key="LineColor">#223042</Color>              <!-- 구분선 -->
        <Color x:Key="EdgeColor">#2E4058</Color>              <!-- 버튼·콤보 테두리 · 슬라이더 레일 -->
        <Color x:Key="EdgeHoverColor">#3E5574</Color>
        <Color x:Key="WindowEdgeColor">#263447</Color>        <!-- 창 테두리 (Windows 11) -->
        <Color x:Key="TextColor">#E2E8F0</Color>
        <Color x:Key="BrightTextColor">#FFFFFF</Color>        <!-- 켜진 버튼 글자 -->
        <Color x:Key="SubTextColor">#9AA8BA</Color>
        <Color x:Key="MutedTextColor">#64748B</Color>
        <Color x:Key="DisabledTextColor">#4A5A6E</Color>
        <Color x:Key="AccentColor">#6CB2FF</Color>
        <Color x:Key="AccentBackColor">#18304D</Color>        <!-- 지금 소스 버튼 · 재생 버튼 바탕 -->
        <Color x:Key="AccentHoverBackColor">#1F3B5E</Color>
        <Color x:Key="OkColor">#4ADE80</Color>                <!-- 상태 점 (소스 켜짐) -->
        <Color x:Key="WarnColor">#FBBF24</Color>              <!-- NPU 진행 · 캡처 끊김 -->
        <Color x:Key="DangerColor">#F87171</Color>            <!-- ● LIVE/HUD · 검출·캡처 오류 · 정지 -->
        <Color x:Key="DangerBackColor">#1E1216</Color>
        <Color x:Key="DangerHoverBackColor">#2A171D</Color>
        <Color x:Key="DangerEdgeColor">#5B2B33</Color>
        <Color x:Key="DangerTextColor">#FCA5A5</Color>

        <SolidColorBrush x:Key="BaseBrush" Color="{StaticResource BaseColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="SideBrush" Color="{StaticResource SideColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="RaisedHoverBrush" Color="{StaticResource RaisedHoverColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="PopupBrush" Color="{StaticResource PopupColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="StatusBrush" Color="{StaticResource StatusColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="EdgeBrush" Color="{StaticResource EdgeColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="EdgeHoverBrush" Color="{StaticResource EdgeHoverColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="BrightTextBrush" Color="{StaticResource BrightTextColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource SubTextColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="AccentBackBrush" Color="{StaticResource AccentBackColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="AccentHoverBackBrush" Color="{StaticResource AccentHoverBackColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="DangerBackBrush" Color="{StaticResource DangerBackColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="DangerHoverBackBrush" Color="{StaticResource DangerHoverBackColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="DangerEdgeBrush" Color="{StaticResource DangerEdgeColor}" po:Freeze="True"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="{StaticResource DangerTextColor}" po:Freeze="True"/>

        <!-- ===== 검출 박스 (BoxLayer — HUD 오버레이와 앱 안 영상이 같이 쓴다. 처음 그릴 때 한 번 읽는다) =====
             클래스 색 키 = "Box." + 모델 라벨, 목록에 없는 라벨은 Box.Other. 가장 흔한 car 는 강조색과 같은 계열.
             왼쪽 위 클래스별 개수 범례도 같은 글꼴·클래스 색을 쓴다(바탕은 Box.LegendBack) (범례 줄 순서는 아래 클래스 순서 — BoxLayer.LegendOrder) -->
        <Color x:Key="Box.car">#7CC4FF</Color>
        <Color x:Key="Box.truck">#FFAB5E</Color>
        <Color x:Key="Box.bus">#B9A2FF</Color>
        <Color x:Key="Box.motorcycle">#5FD8C8</Color>
        <Color x:Key="Box.scooter">#F6DE6B</Color>
        <Color x:Key="Box.bicycle">#A8DE73</Color>
        <Color x:Key="Box.person">#FF7B9A</Color>
        <Color x:Key="Box.Other">#E2E8F0</Color>
        <!-- 투명도 (2026-11-02 사용자 요청으로 '살짝 더 투명하게': 라벨 바탕 86→72%, 꺾쇠 100→85%, 테두리 40→30%, 꺾쇠 둘레 45→35%). 라벨 글자는 그대로 불투명 -->
        <Color x:Key="Box.LabelBack">#B80B1118</Color>        <!-- 라벨 바탕 (불투명도 72%) — 라벨 뒤 영상이 비쳐 보이게 -->
        <Color x:Key="Box.LegendBack">#DB0B1118</Color>       <!-- 범례 바탕 (86% 그대로 — 줄이 여럿인 표라 라벨보다 진하게 둔다) -->
        <Color x:Key="Box.Halo">#59000000</Color>             <!-- 꺾쇠 둘레 어두운 테두리 — 밝은 배경에서도 보이게 (35%) -->
        <Color x:Key="Box.LegendText">#E2E8F0</Color>         <!-- 범례 개수·합계 (TextColor 와 같은 값) -->
        <Color x:Key="Box.LegendSubText">#9AA8BA</Color>      <!-- 범례 머리 '검출' (SubTextColor 와 같은 값) -->
        <sys:Double x:Key="Box.CornerOpacity">0.85</sys:Double> <!-- 모서리 꺾쇠의 불투명도 -->
        <sys:Double x:Key="Box.FrameOpacity">0.3</sys:Double> <!-- 꺾쇠 사이를 잇는 1px 테두리의 불투명도 -->
        <FontFamily x:Key="Box.Font">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>
        <sys:Double x:Key="Box.FontSize">11</sys:Double>
        <!-- 작은 물체의 라벨·꺾쇠 (2026-11-02): 화면에서 물체 크기 √(폭×높이) 가 FullSizeFrom(DIP) 이상이면 기본 크기, 그보다 작으면
             라벨(글자·여백·막대)과 모서리 꺾쇠(굵기·팔 길이의 하한)를 크기에 비례해 줄인다. MinScale 이 하한 (글자 11 → 6.6 — 더 작으면 읽을 수 없다) -->
        <sys:Double x:Key="Box.FullSizeFrom">48</sys:Double>
        <sys:Double x:Key="Box.MinScale">0.45</sys:Double>   <!-- 2026-11-03: 0.6 → 0.45 (사용자 요청 — 작은 물체를 더 줄이고 아래 TinyOpacity 로 더 옅게) -->
        <sys:Double x:Key="Box.TinySize">14</sys:Double>       <!-- 이 크기(DIP, √(폭×높이)) 이하는 가장 옅게 (Box.FullSizeFrom 에서 1 로 직선) -->
        <sys:Double x:Key="Box.TinyOpacity">0.45</sys:Double>  <!-- 가장 작은 물체의 박스·라벨 불투명도 배율 -->

        <!-- ===== 관심 구역 (RoiLayer·왼쪽 패널 '구역' 목록 — 처음 쓸 때 한 번 읽는다) =====
             키 = "Roi." + 구역 유형(RoiKinds.Key). 색은 박스 클래스 색과 겹치지 않는 계열 — 차로 = 강조색, 갓길 = 호박, 정지선·대기 = 보라, 무시 = 회청(점선) -->
        <Color x:Key="Roi.lane">#6CB2FF</Color>
        <Color x:Key="Roi.shoulder">#F5B94A</Color>
        <Color x:Key="Roi.stopline">#B9A2FF</Color>
        <Color x:Key="Roi.ignore">#94A3B8</Color>
        <sys:Double x:Key="Roi.FillOpacity">0.16</sys:Double>    <!-- 구역 안쪽 칠의 불투명도 — 영상이 비쳐 보이게 -->

        <!-- 영상 위 화면 전환 배지 바탕 (MainWindow.Scene.cs) — 범례와 같은 바탕 -->
        <SolidColorBrush x:Key="BadgeBackBrush" Color="{StaticResource Box.LegendBack}" po:Freeze="True"/>

        <!-- ===== 글꼴 =====
             UI: 라틴은 Segoe UI Variable, 한글은 맑은 고딕으로 넘어간다 (WPF 가 글자마다 목록 순서대로 찾는다).
             상태바 크기를 바꾸면 최소 폭(900)에서 HUD 상태 문구가 말줄임되지 않는지 다시 잴 것 (CLAUDE.md '상태바') -->
        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Malgun Gothic</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Malgun Gothic</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <sys:Double x:Key="UiFontSize">13</sys:Double>
        <sys:Double x:Key="StatusFontSize">12</sys:Double>
        <!-- 상태바 FPS·검출 칸 폭 (2026-11-02) — 값이 바뀌어도 왼쪽 글자(해상도·NPU 진행)가 안 밀리게 고정한다 (MainWindow.xaml 상태바 주석).
             FPS 칸: 파일·카메라는 숫자 '999.9 FPS'(49px) 폭, HUD 는 그 자리에 숫자와 번갈아 뜨는 '대기 (화면 변화 없음)'·'캡처 끊김 (재연결 중)' 등(113px) 폭 —
             ApplyModeToUi 가 모드에 따라 고른다. 검출 칸: '검출 999'(45px). 상태바 글꼴(12px Display)로 잰 폭 + 화면 배율 반올림 여유 1px -->
        <sys:Double x:Key="StatusFpsWidth">50</sys:Double>
        <sys:Double x:Key="StatusFpsHudWidth">114</sys:Double>
        <sys:Double x:Key="StatusCountWidth">46</sys:Double>
        <sys:Double x:Key="LabelFontSize">11</sys:Double>
        <sys:Double x:Key="IconFontSize">15</sys:Double>

        <!-- 재생 위치 슬라이더 아래 눈금 (6칸, 장식) -->
        <DrawingBrush x:Key="TickBrush" TileMode="Tile" Stretch="None" AlignmentX="Left" AlignmentY="Top"
                      Viewport="0,0,0.1666667,1" ViewportUnits="RelativeToBoundingBox" po:Freeze="True">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource EdgeBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,1,5"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 키보드 포커스 표시 (기본 점선은 어두운 바탕에서 안 보인다) -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 글자 ===== -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource LabelFontSize}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource LabelFontSize}"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>

        <!-- ===== 버튼 =====
             글자(Content)는 문자열 그대로 둔다 — UI 테스트가 버튼 글자(UIA 이름)로 찾고 읽는다. 아이콘은 local:Ui.Glyph 로 템플릿이 그린다
             (아이콘을 Content 에 넣으면 UIA 이름이 빈다). 지금 소스 버튼은 local:Ui.IsActive (ApplyModeToUi) -->
        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="local:Ui.GlyphBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="local:Ui.HoverBackground" Value="{StaticResource RaisedHoverBrush}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <StackPanel x:Name="row" Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <TextBlock x:Name="glyph" Text="{Binding (local:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{Binding (local:Ui.GlyphBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="{StaticResource IconFontSize}"
                                           VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <ContentPresenter x:Name="label" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:Ui.Glyph" Value="{x:Null}">
                                <Setter TargetName="glyph" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="local:Ui.IconOnly" Value="True">
                                <Setter TargetName="label" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="glyph" Property="Margin" Value="0"/>
                                <Setter TargetName="row" Property="HorizontalAlignment" Value="Center"/>
                                <Setter TargetName="bd" Property="Padding" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding (local:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="local:Ui.IsActive" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBackBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrightTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="local:Ui.IsActive" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBackBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource FieldBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SideBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 재생/일시정지: 늘 강조 테두리. 아이콘은 버튼 글자(코드가 바꾼다)를 따른다 -->
        <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource SideButton}">
            <Setter Property="Background" Value="{StaticResource AccentBackBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource BrightTextBrush}"/>
            <Setter Property="local:Ui.HoverBackground" Value="{StaticResource AccentHoverBackBrush}"/>
            <Setter Property="local:Ui.Glyph" Value="&#xE768;"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Content" Value="일시정지">
                    <Setter Property="local:Ui.Glyph" Value="&#xE769;"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 정지: 소스를 내린다 -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SideButton}">
            <Setter Property="Background" Value="{StaticResource DangerBackBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerEdgeBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}"/>
            <Setter Property="local:Ui.GlyphBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="local:Ui.HoverBackground" Value="{StaticResource DangerHoverBackBrush}"/>
        </Style>

        <!-- ===== 콤보 ===== -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="bd" Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="3">
                <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource EdgeHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="bd" Property="Background" Value="{StaticResource SideBrush}"/>
                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                    <Setter TargetName="chev" Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="MaxDropDownHeight" Value="320"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press" Template="{StaticResource ComboToggle}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Grid Margin="10,0,28,0" IsHitTestVisible="False" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="glyph" Text="{Binding (local:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <!-- 긴 카메라 이름은 "…" 로 (선택 칸은 폭이 좁다) -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Grid>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="4" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        TextElement.FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">
                                    <ScrollViewer>
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="local:Ui.Glyph" Value="{x:Null}">
                                <Setter TargetName="glyph" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 막힌 항목(NPU 를 쓸 수 없을 때)도 툴팁이 뜨게 바탕을 칠해 둔다 (Transparent — 히트 테스트) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="bar" Width="3" Height="14" CornerRadius="1.5" Margin="-7,0,0,0" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RaisedHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 구역 목록 (왼쪽 패널 '구역') — 항목은 RoiListItem (MainWindow.Roi.cs). 고른 항목은 '지금 소스 버튼'과 같은 강조 바탕.
             UIA 이름은 "Z1 차로" (AutomationProperties.Name 을 DisplayName 에 묶는다) ===== -->
        <Style x:Key="ZoneListItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RaisedHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBackBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrightTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SideBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ZoneListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ZoneListItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 이벤트 로그 목록 (영상 아래 접이식 로그) — 항목은 EventListItem (MainWindow.Events.cs). 한 줄 20px, 바탕 없이 얇게 (구역 목록의 큰 칸과 다르다).
             UIA 이름은 "00:11.2 CAR #40 Z1 차로 진입" ===== -->
        <Style x:Key="LogListItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="20"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource RaisedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentBackBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LogListBox" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource BaseBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LogListItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                            <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 재생 위치 슬라이더 =====
             PART_Track 이름은 바꾸지 말 것 — Slider 가 쓰고, 창을 떠날 때 드래그를 끝내는 코드(Window_Deactivated)도 이걸로 썸을 찾는다 -->
        <Style x:Key="SliderBar" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="2" VerticalAlignment="Center" Background="{TemplateBinding Background}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="14" Height="24" Background="Transparent">
                            <Border Width="4" Height="14" Background="{StaticResource AccentBrush}">
                                <Border.Effect>
                                    <DropShadowEffect Color="{StaticResource AccentColor}" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="24" Background="Transparent">
                            <Rectangle Height="5" VerticalAlignment="Bottom" Fill="{StaticResource TickBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource SliderBar}" Background="{StaticResource AccentBrush}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderBar}" Background="{StaticResource EdgeBrush}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_Track" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 스크롤바 (콤보 펼침 · 낮은 창의 왼쪽 패널) ===== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" Margin="1" CornerRadius="3" Background="{StaticResource EdgeBrush}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource EdgeHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}"/>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 툴팁 =====
             내용은 문자열 그대로 둔다 — UI 테스트가 툴팁을 UIA HelpText 로 읽는다 (문자열 툴팁만 HelpText 가 된다) -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource PopupBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="{StaticResource StatusFontSize}"/>
            <Setter Property="MaxWidth" Value="560"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,7">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 영상 칸 모서리 눈금 (장식, 영상 뒤에 깔린다) -->
        <Style x:Key="CornerTick" TargetType="Border">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

    </Application.Resources>
</Application>
